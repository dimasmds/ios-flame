diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -9,12 +9,13 @@
 
 #if defined(SWEET)
 #include <stdint.h>
+#include <arm64/proc_reg.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c400000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
+#define EARLY_HEIGHT 2280u
 #define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
@@ -125,10 +126,77 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+static void
+flame_early_hex(const char *label, uint64_t value)
+{
+	sweet_early_string(label);
+	sweet_early_putc(' ');
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		unsigned int digit = (value >> shift) & 15;
+		sweet_early_putc((char)(digit < 10 ? '0' + digit : 'a' + digit - 10));
+	}
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* The original identity mapping is still live during this diagnosis. Read
+ * only table pages inside the selected Pixel RAM range, never MMIO. */
+static void
+flame_early_walk(uint64_t root, uint64_t va)
+{
+	uint64_t table = root & ARM_TTE_TABLE_MASK;
+	for (unsigned int level = 1; level <= 3; level++) {
+		if ((table & (ARM_PGBYTES - 1)) || table < 0x100000000ULL ||
+		    table > 0x140000000ULL - ARM_PGBYTES) {
+			sweet_early_string("FLAME TABLE PA OUTSIDE RAM\n");
+			return;
+		}
+		unsigned int index = level == 1 ? (va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT :
+		    level == 2 ? (va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT :
+		    (va & ARM_TT_L3_INDEX_MASK) >> ARM_TT_L3_SHIFT;
+		uint64_t entry = ((volatile uint64_t *)(uintptr_t)table)[index];
+		flame_early_hex(level == 1 ? "FLAME L1" : level == 2 ? "FLAME L2" : "FLAME L3", entry);
+		if ((entry & 3) != 3) return;
+		table = entry & ARM_TTE_TABLE_MASK;
+	}
+}
+
+static uint64_t
+flame_early_translate(uint64_t va)
+{
+	uint64_t result;
+	__asm__ volatile("at s1e1w, %1; isb; mrs %0, par_el1" : "=r"(result) : "r"(va) : "memory");
+	return result;
+}
+
 void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	uint64_t root, tcr;
+	__asm__ volatile("mrs %0, ttbr1_el1" : "=r"(root));
+	__asm__ volatile("mrs %0, tcr_el1" : "=r"(tcr));
+	flame_early_hex("FLAME FB VA", base);
+	flame_early_hex("FLAME TTBR1", root);
+	flame_early_hex("FLAME TCR", tcr);
+	flame_early_walk(root, base);
+	flame_early_hex("FLAME PAR BEFORE", flame_early_translate(base));
+	uint64_t last = base + EARLY_WIDTH * EARLY_HEIGHT * 4 - 1;
+	/* A newly installed alias must not inherit a cached failed translation. */
+	__asm__ volatile("dsb ishst; tlbi vaae1is, %0; tlbi vaae1is, %1; dsb ish; isb" : :
+	    "r"((base >> 12) & 0xfffffffffffULL), "r"((last >> 12) & 0xfffffffffffULL) : "memory");
+	uint64_t first_par = flame_early_translate(base);
+	uint64_t last_par = flame_early_translate(last);
+	flame_early_hex("FLAME PAR FIRST", first_par);
+	flame_early_hex("FLAME PAR LAST", last_par);
+	if ((first_par & 1) || (last_par & 1) ||
+	    (first_par & 0x0000fffffffff000ULL) != 0x9c400000ULL ||
+	    (last_par & 0x0000fffffffff000ULL) != ((0x9c400000ULL + EARLY_WIDTH * EARLY_HEIGHT * 4 - 1) & ~0xfffULL)) {
+		sweet_early_string("FLAME FINAL FB TRANSLATION FAILED\n");
+		sweet_early_string("CAPTURE VALUES THEN RESTART PHONE\n");
+		__asm__ volatile("dsb sy" ::: "memory");
+		for (;;) __asm__ volatile("wfe");
+	}
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
